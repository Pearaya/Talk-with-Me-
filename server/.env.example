# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://coaching:coaching@localhost:5432/coaching?schema=public

# JWT
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
